   "source": [
    "def factorial(n):\n",
    "    dp = [0] * (n + 1)\n",
    "    dp[0] = 1      #0! = 1\n",
    "\n",
    "    for i in range(1, n + 1):\n",
    "        dp[i] = dp[i - 1] * i\n",
    "\n",
    "    return dp[n]\n",
    "\n",
    "n = int(input(\"Enter number\"))\n",
    "result = factorial(n)\n",
    "print(f\"The factorial of {n} is {result}\")"
   ],
